@using BlogManager_PhanThePho.Models
@model Post

<h1>@Model.Title</h1>

<p><strong>Tác giả:</strong> @Model.Author</p>

<p><strong>Ngày đăng:</strong> @Model.PublishedAt.ToString("dd/MM/yyyy")</p>

<p><strong>Trạng thái:</strong>
    @(Model.IsPublished ? "Đã xuất bản" : "Nháp")
</p>

<hr>

<h4>Nội dung</h4>

<p>@Model.Content</p>

<div class="mt-3">
    <a asp-controller="Posts" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Chỉnh sửa</a>
    <a asp-controller="Posts" asp-action="Index" class="btn btn-secondary ms-2">Quay lại</a>
</div>