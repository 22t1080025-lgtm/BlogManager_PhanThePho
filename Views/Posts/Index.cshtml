@model BlogManager_PhanThePho.Models.PostListViewModel

@{
    ViewData["Title"] = "Danh sách bài viết";
}

<h2 class="my-3">Danh sách bài viết</h2>

<div class="d-flex justify-content-between align-items-center mb-3">
    <a asp-action="Create" class="btn btn-success">+ Thêm bài viết mới</a>

    @* Form tìm kiếm + sắp xếp (Slide 11) *@
    <form asp-action="Index" method="get" class="row g-2 align-items-center">
        <div class="col-auto">
            <input name="search" value="@Model.Search" class="form-control" placeholder="Tìm theo tiêu đề..." />
        </div>
        <div class="col-auto">
            <select name="sort" class="form-select">
                <option value="" selected="@(string.IsNullOrEmpty(Model.Sort))">Mới nhất</option>
                <option value="oldest" selected="@(Model.Sort == "oldest")">Cũ nhất</option>
                <option value="title" selected="@(Model.Sort == "title")">Theo tiêu đề</option>
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Tìm</button>
            @if (!string.IsNullOrEmpty(Model.Search) || !string.IsNullOrEmpty(Model.Sort))
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a>
            }
        </div>
    </form>
</div>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Tiêu đề</th>
            <th>Chuyên mục</th>
            <th>Tác giả</th>
            <th>Ngày đăng</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
    @if (Model.Posts != null && Model.Posts.Any())
    {
        @foreach (var post in Model.Posts)
        {
            <tr>
                <td>@post.Title</td>
                <td>
                    <span class="badge bg-secondary">
                        @(post.Category?.Name ?? "Chưa phân loại")
                    </span>
                </td>
                <td>@post.Author</td>
                <td>@post.PublishedAt.ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@post.Id" class="btn btn-sm btn-info">Chi tiết</a>
                    <a asp-action="Edit" asp-route-id="@post.Id" class="btn btn-sm btn-warning">Sửa</a>
                    <a asp-action="Delete" asp-route-id="@post.Id" class="btn btn-sm btn-danger">Xóa</a>
                </td>
            </tr>
        }
    }
    else
    {
        <tr>
            <td colspan="5" class="text-center text-muted">Không tìm thấy bài viết nào.</td>
        </tr>
    }
    </tbody>
</table>

@* Thanh phân trang Bootstrap (Slide 14) *@
@if (Model.TotalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-search="@Model.Search"
                       asp-route-sort="@Model.Sort"
                       asp-route-pageNumber="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}