@model IEnumerable<BlogManager_PhanThePho.Models.Post>

@{
    ViewData["Title"] = "Danh sách bài viết";
}

<h2 class="my-3">Danh sách bài viết</h2>

<p>
    <a asp-action="Create" class="btn btn-success">+ Thêm bài viết mới</a>
</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Tiêu đề</th>
            <th>Tác giả</th>
            <th>Ngày đăng</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var post in Model)
    {
        <tr>
            <td>@post.Title</td>
            <td>@post.Author</td>
            <td>@post.PublishedAt.ToString("dd/MM/yyyy HH:mm")</td>
            <td>
                <a asp-action="Details" asp-route-id="@post.Id" class="btn btn-sm btn-info">Chi tiết</a>
                <a asp-action="Edit" asp-route-id="@post.Id" class="btn btn-sm btn-warning">Sửa</a>
                <a asp-action="Delete" asp-route-id="@post.Id" class="btn btn-sm btn-danger">Xóa</a>
            </td>
        </tr>
    }
    </tbody>
</table>